# Copy this file to `.env` and replace the values with your own.

# Public and secret keys from your Langfuse project.  You can find them
# in the project settings under "API keys".  When running locally
# against a self‑hosted Langfuse instance, these keys will authenticate
# requests.  Note that exposing your secret key to the frontend is not
# recommended for production systems; instead call the API from a backend
# service.  For a local POC this is acceptable.
VITE_LANGFUSE_PUBLIC_KEY=pk-lf-example
VITE_LANGFUSE_SECRET_KEY=sk-lf-example

# Base URL of your Langfuse deployment.  Use http://localhost:3000 if
# you are running the open source Langfuse server locally.  For the EU
# cloud region use https://cloud.langfuse.com.  For the US cloud region
# use https://us.cloud.langfuse.com.
VITE_LANGFUSE_BASE_URL=http://localhost:3000